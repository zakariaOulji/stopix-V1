# Copy this file to `.env` and adjust. `.env` is git-ignored: never commit it.
# Only vars prefixed with EXPO_PUBLIC_ are available in the app at runtime, and
# they end up in the shipped bundle: put NO server secret here (service_role
# key, OpenAI / Google keys live in Supabase Edge Function secrets).

# Keep the app fully on local mock data (no network). Set to "false" to use Supabase.
EXPO_PUBLIC_USE_MOCKS=true

# Supabase project (Settings → API). Used only when USE_MOCKS=false.
# The anon / publishable key is public by design: data is protected by RLS.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Network timeout for API requests, in milliseconds.
EXPO_PUBLIC_REQUEST_TIMEOUT=15000
