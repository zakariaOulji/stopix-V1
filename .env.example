# Copy this file to `.env` and adjust.
# Only vars prefixed with EXPO_PUBLIC_ are available in the app at runtime.

# Keep the app fully on local mock data (no network). Set to "false" to hit the API.
EXPO_PUBLIC_USE_MOCKS=true

# Base URL of the STOPIX backend (used only when USE_MOCKS=false).
EXPO_PUBLIC_API_URL=https://api.stopix.app

# Network timeout for API requests, in milliseconds.
EXPO_PUBLIC_REQUEST_TIMEOUT=15000
